GEMINI_API_KEY=your_gemini_api_key_here
# Optional: add more keys for higher quota (auto fallback on 429)
# GEMINI_API_KEYS=key1,key2,key3
# Or on HF Spaces: GEMINI_API_KEY_2, GEMINI_API_KEY_3, ... (up to 9)

# Grok (xAI) as fallback provider
# GROK_API_KEY=your_grok_api_key_here
# GROK_MODEL=grok-3-mini  # or grok-3, grok-3-fast
# GROK_API_KEY_2=second_key  # HF Spaces

MAX_FILE_MB=50
API_URL=http://localhost:8000
